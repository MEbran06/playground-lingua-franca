target Python

reactor CameraSensor {
    output image_path
    input change_frame


    logical action next_image

    state frames_ref
    state current_frame_pos

    preamble {=
        import glob

        def get_all_frames(self, path):
            # sets a list of strings corresponding to the paths of the images
            self.frames_ref = self.glob.glob(path+"/*.jpg")

        def get_current(self):
            return self.frames_ref[self.current_frame_pos]
    =}

    reaction(change_frame) -> next_image {=
        # move to the next frame (avoid going out of bounds)
        self.current_frame_pos = (self.current_frame_pos + 1) % len(self.frames_ref)
        next_image.schedule(0)
    =}

    reaction(startup) -> next_image {=

        self.get_all_frames("pictures")
        self.current_frame_pos = 0
        # Trigger first user prompt
        next_image.schedule(0)
    =}

    reaction(next_image) -> image_path {=
        import time
        file_path = self.get_current()
        if file_path.strip():
            image_path.set(file_path)
    =}
}

reactor ClipEmbedder {
    input image_path
    output clip_record

    reaction(startup) {=
        from transformers import CLIPProcessor, CLIPModel
        import torch

        model_id = "openai/clip-vit-base-patch32"

        self.processor = CLIPProcessor.from_pretrained(model_id, use_fast=True)
        self.model = CLIPModel.from_pretrained(model_id)
        self.model.eval()

        self.device = "cpu"
        self.model.to(self.device)
    =}

  reaction(image_path) -> clip_record {=
    import torch
    from PIL import Image
    try:
        img = Image.open(image_path.value).convert("RGB").copy()

        inputs = self.processor(images=img, return_tensors="pt")

        with torch.no_grad():
            feats = self.model.get_image_features(**inputs)

        # normalize so cosine similarity = dot product
        feats = feats / feats.norm(dim=-1, keepdim=True)

        vec = feats[0].cpu().tolist()

        clip_record.set({"path": image_path.value, "vec": vec})
        print("clip vector set and true")

    except Exception as e:
        print("CLIP embedding failed:", e)
  =}
}

reactor SemanticCache {
  input clip_record
  input store_decision

  output cached_decision
  output miss_image_path

  state threshold
  state collection
  state last_query
  state last_image_path

  reaction(startup) {=
    import os
    import chromadb

    self.threshold = 0.85
    self.last_query = None
    self.last_image_path = None

    persist_dir = os.path.join(os.getcwd(), "chroma_db")
    client = chromadb.PersistentClient(path=persist_dir)
    self.collection = client.get_or_create_collection(
      name="road_descriptor_cache",
      metadata={"hnsw:space": "cosine"}
    )
  =}

  // Query: nearest neighbor by cosine similarity (dot product).
  reaction(clip_record) -> cached_decision, miss_image_path {=
    import numpy as np

    q = np.asarray(clip_record.value["vec"], dtype=np.float32).copy()
    self.last_query = q
    self.last_image_path = str(clip_record.value["path"])

    if self.collection is None:
      cached_decision.set("")
      miss_image_path.set(self.last_image_path)
      return

    results = self.collection.query(
      query_embeddings=[q.tolist()],
      n_results=1
    )

    distances = results.get("distances", [[]])[0]
    documents = results.get("documents", [[]])[0]

    if not distances:
      cached_decision.set("")
      miss_image_path.set(self.last_image_path)
      return

    best_distance = float(distances[0])
    similarity = 1.0 - best_distance

    if similarity >= self.threshold:
      cached_decision.set(documents[0] if documents else "")
    else:
      cached_decision.set("")
      miss_image_path.set(self.last_image_path)
  =}

  // Store: insert vec + decision with fixed capacity
  reaction(store_decision) {=
    import numpy as np

    if not store_decision.is_present:
      return

    if store_decision.value is None or store_decision.value.strip() == "":
      return

    if self.last_query is None or self.last_image_path is None:
      return

    v = np.asarray(self.last_query, dtype=np.float32).copy()

    self.collection.upsert(
      ids=[str(self.last_image_path)],
      embeddings=[v.tolist()],
      documents=[store_decision.value],
      metadatas=[{"path": str(self.last_image_path), "decision": store_decision.value}]
    )
  =}
}

reactor VLMInference {
    input inputed_image_path
    output response
    logical action poll

    state descriptor_prompt
    state model
    state inference_thread
    state inference_lock
    state inference_in_progress
    state inference_result
    state inference_error

    state model_loading_time
    state image_encoding_time
    state prefill_time
    state decode_time_avg
    state inference_time
    state end_to_end_latency
    state config
    state backend

    preamble {=
        import threading
        import time
        import traceback
        from PIL import Image
        from transformers import AutoConfig
        from ollama import chat

        # generated_dir = os.path.dirname(os.path.abspath(__file__))
        # package_dir = os.path.abspath(os.path.join(generated_dir, "..", ".."))
        # src_path = os.path.join(package_dir, "src")
        # if src_path not in sys.path:
        #     sys.path.insert(0, src_path)

        # from backend import BackendFactory

        #model_id = "qwen2.5vl"
        model_id = "moondream"

        # t = time.time()
        # _config = AutoConfig.from_pretrained(model_id, trust_remote_code=True)
        # # factory class that returns the correct backend based on the model
        # _backend = BackendFactory(model_id, _config)
        # print(f"Model Load time: {time.time() - t:.3f}")

        def run_vlm_job(self, image_path):
            """Run the blocking VLM work outside the LF reaction thread."""
            try:

                # t0 = self.time.time()
                # image_value = self.Image.open(image_path).convert("RGB").copy()
                # load_image_time = self.time.time() - t0

                outStream = self.chat(
                    model=self.model_id,
                    messages=[{"role": "user", 
                                "content": self.descriptor_prompt,
                                "images": [image_path] }],
                    stream=True,
                )
               
                out = ""
                last_chunk = None

                for chunk in outStream:
                    if chunk.message.content:
                        out += chunk.message.content
                    last_chunk = chunk

                final_chunk = last_chunk if last_chunk is not None else None

                prompt_eval_count = getattr(final_chunk, "prompt_eval_count", None) or 0
                prompt_eval_duration = getattr(final_chunk, "prompt_eval_duration", None) or 0
                eval_count = getattr(final_chunk, "eval_count", None) or 0
                eval_duration = getattr(final_chunk, "eval_duration", None) or 0
                total_duration = getattr(final_chunk, "total_duration", None) or 0
                load_duration = getattr(final_chunk, "load_duration", None) or 0

                prefill_time = prompt_eval_duration / 1_000_000_000.0
                total_decode_time = eval_duration / 1_000_000_000.0
                avg_decode_ms_per_token = (eval_duration / 1_000_000.0) / eval_count if eval_count > 0 else 0.0
                decode_tokens_per_second = eval_count / total_decode_time if total_decode_time > 0 else 0.0
                total_latency = total_duration / 1_000_000_000.0
                load_time = load_duration / 1_000_000_000.0
                image_phase_time = total_latency - (prefill_time + total_decode_time + load_time)

                result = {
                    "text": out.strip(),
                    "avg_decode_ms_per_token": avg_decode_ms_per_token,
                    "decode_tokens_per_second": decode_tokens_per_second,
                    "total_decode_time": total_decode_time,
                    "prefill_time": prefill_time,
                    "prompt_eval_count": prompt_eval_count,
                    "eval_count": eval_count,
                    "total_latency": total_latency,
                    "load_time": load_time,
                    "image_phase_time": image_phase_time,
                }

                with self.inference_lock:
                    self.inference_result = result
                    self.inference_error = None
                    self.inference_in_progress = False

            except Exception:
                with self.inference_lock:
                    self.inference_result = None
                    self.inference_error = self.traceback.format_exc()
                    self.inference_in_progress = False
    =}


    // initialize our state
    reaction(startup) {=
        import torch        
        import sys
        import os
        import time

        generated_dir = os.path.dirname(os.path.abspath(__file__))
        package_dir = os.path.abspath(os.path.join(generated_dir, "..", ".."))
        src_path = os.path.join(package_dir, "src")
        if src_path not in sys.path:
            sys.path.insert(0, src_path)

        from prompts import descriptor_prompt

        # self.config = self._config
        # self.backend = self._backend

        self.descriptor_prompt = descriptor_prompt
        self.inference_thread = None
        self.inference_lock = self.threading.Lock()
        self.inference_in_progress = False
        self.inference_result = None
        self.inference_error = None
    =}

    reaction(inputed_image_path) -> poll {=

        with self.inference_lock:
            if self.inference_in_progress:
                print("VLM inference is still running; dropping incoming image.")
                return

            self.inference_in_progress = True
            self.inference_result = None
            self.inference_error = None

        image_path_for_inference = str(inputed_image_path.value)

        self.inference_thread = self.threading.Thread(
            target=self.run_vlm_job,
            args=(image_path_for_inference,),
            daemon=True
        )
        self.inference_thread.start()
        poll.schedule(MSEC(100))

    =} deadline(5 sec) {=
        print("Deadline violation of VLM detected.")
    =}

    reaction(poll) -> response, poll {=

        with self.inference_lock:
            result = self.inference_result
            error = self.inference_error
            in_progress = self.inference_in_progress

            if result is not None or error is not None:
                self.inference_result = None
                self.inference_error = None

        if in_progress:
            poll.schedule(MSEC(100))
            return

        if error is not None:
            print("VLM inference failed:")
            print(error)
            response.set("[VLM inference failed]")
            return

        if result is not None:
            self.decode_time_avg = result["avg_decode_ms_per_token"]
            self.prefill_time = result["prefill_time"]
            self.inference_time = result["total_decode_time"] + result["prefill_time"]
            self.end_to_end_latency = result["total_latency"]

            print(f"Average Decode time: {self.decode_time_avg:.3f} ms/token")
            print(f"Decode throughput: {result['decode_tokens_per_second']:.1f} tokens/s")
            print(f"Total Decode time: {result['total_decode_time']:.3f}s")
            print(f"Prefill time: {self.prefill_time:.3f}s")
            print(f"Load time: {result['load_time']:.3f}s")
            print(f"Image phase (residual): {result['image_phase_time']:.3f}s")
            print(f"Prompt tokens: {result['prompt_eval_count']}")
            print(f"Generated tokens: {result['eval_count']}")
            print(f"End to End latency time: {self.end_to_end_latency:.3f}s")
            response.set(result["text"])
    =}

}

reactor ActionDisplay {
    input response
    input cached_response
    output triggerSensor
    output store_decision
    logical action trigger

    state avg_frame_period
    state fps
    state first_output_time
    state last_output_time
    state frame_period_accumulator
    state counter

    reaction(startup)
    {=
        self.counter = 0
        self.first_output_time = None
        self.last_output_time = None
        self.frame_period_accumulator = 0.0
        self.avg_frame_period = 0.0
        self.fps = 0.0
    =}

    reaction(response, cached_response) ->  trigger, store_decision {=
        if (cached_response.is_present and cached_response.value != ""):
            print("AI:", cached_response.value)
            trigger.schedule(0)
            
        elif (response.is_present):
            print("AI:", response.value)
            store_decision.set(response.value)
            trigger.schedule(0)
    =}

    reaction(trigger) -> triggerSensor {=
        import time
        triggerSensor.set(1)
        now = time.time()

        if self.counter == 0:
            self.first_output_time = now
        else:
            self.frame_period_accumulator += now - self.last_output_time
            self.avg_frame_period = self.frame_period_accumulator / self.counter
            self.fps = 1.0 / self.avg_frame_period if self.avg_frame_period > 0 else 0.0

        self.last_output_time = now
        self.counter += 1
    =}

    reaction(shutdown) {=
        print(f"Frames processed: {self.counter}")
        print(f"Avg inter-frame period: {self.avg_frame_period:.3f}s")
        print(f"FPS: {self.fps:.3f}")
    =}


}

main reactor {
    u = new CameraSensor()
    descriptor = new VLMInference()
    o = new ActionDisplay()
    clip = new ClipEmbedder()
    s = new SemanticCache()

    u.image_path -> clip.image_path

    clip.clip_record -> s.clip_record

    s.cached_decision -> o.cached_response
    s.miss_image_path -> descriptor.inputed_image_path
    descriptor.response -> o.response
    
    o.store_decision -> s.store_decision
    o.triggerSensor -> u.change_frame after 0
}
